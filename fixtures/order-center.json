{
  "openapi": "3.0.3",
  "info": {
    "title": "订单中心 API",
    "version": "1.3.0",
    "description": "订单查询与售后接口，供接入示例使用"
  },
  "servers": [{ "url": "http://127.0.0.1:3300/upstream/_sandbox" }],
  "paths": {
    "/orders/{orderNo}": {
      "get": {
        "operationId": "getOrder",
        "summary": "查询订单详情",
        "description": "按订单号查询订单状态与金额",
        "tags": ["订单", "查询"],
        "parameters": [
          { "name": "orderNo", "in": "path", "required": true, "schema": { "type": "string", "example": "O-20261101-001" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/orders": {
      "get": {
        "operationId": "listOrdersByDate",
        "summary": "查询订单列表",
        "description": "按日期拉取当天订单列表",
        "tags": ["订单", "对账"],
        "parameters": [
          { "name": "date", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "pageSize", "in": "query", "required": false, "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/orders/{orderNo}/refund": {
      "post": {
        "operationId": "applyRefund",
        "summary": "订单退款申请",
        "description": "对指定订单发起退款，金额不能超过订单金额",
        "tags": ["订单", "售后", "退款"],
        "parameters": [
          { "name": "orderNo", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "reason"],
                "properties": {
                  "amount": { "type": "number", "example": 99 },
                  "reason": { "type": "string", "example": "商品破损" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    }
  }
}
